      "permanent": true
    },
    {
      "source": "/basketball",
      "destination": "/custom-basketball-uniforms",
      "permanent": true
    },
    {
      "source": "/soccer",
      "destination": "/custom-soccer-uniforms",
      "permanent": true
    },
    {
      "source": "/sublimated-soccer-jerseys-wholesale",
      "destination": "/custom-soccer-uniforms",
      "permanent": true
    },
    {
      "source": "/softball",
      "destination": "/custom-softball-uniforms",
      "permanent": true
    },
    {
      "source": "/volleyball",
      "destination": "/custom-volleyball-uniforms",
      "permanent": true
    },
    {
      "source": "/ice-hockey",
      "destination": "/custom-ice-hockey-uniforms",
      "permanent": true
    },
    {
      "source": "/hockey",
      "destination": "/custom-ice-hockey-uniforms",
      "permanent": true
    },
    {
      "source": "/cricket",
      "destination": "/custom-cricket-uniforms",
      "permanent": true
    },
    {
      "source": "/rugby",
      "destination": "/custom-rugby-uniforms",
      "permanent": true
    },
    {
      "source": "/tennis",
      "destination": "/custom-tennis-apparel",
      "permanent": true
    },
    {
      "source": "/running",
      "destination": "/custom-running-apparel",
      "permanent": true
    },
    {
      "source": "/gym",
      "destination": "/custom-gym-fitness-wear",
      "permanent": true
    },
    {
      "source": "/streetwear",
      "destination": "/custom-streetwear-apparel",
      "permanent": true
    },
    {
      "source": "/sports-wears",
      "destination": "/custom-streetwear-apparel",
      "permanent": true
    },
    {
      "source": "/oem-private-label-sportswear",
      "destination": "/custom-gym-fitness-wear",
      "permanent": true
    },
    {
      "source": "/private-label-activewear-low-moq",
      "destination": "/custom-gym-fitness-wear",
      "permanent": true
    },
    {
      "source": "/custom-sportswear-:state",
      "destination": "/custom",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "destination": "https://www.zarkosportswear.com/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "zarkosportswear.com"
        }
      ]
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/((?!assets/|images/|videos/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(images|videos)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://wear-backend-seven.vercel.app/api/:match*"
    },
    {
      "source": "/builder/models",
      "destination": "/builder/models/index.html"
    },
    {
      "source": "/builder/:id*",
      "destination": "/index.html"
    },
    {
      "source": "/blogs/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/custom-sportswear-:state*",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|images/|videos/|favicon|robots|sitemap).*)",
      "destination": "/index.html"
    }
  ]
}
