{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "^/(.*\\.(js|jsx|css|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot))$", "dest": "/$1" },
    { "src": "^/(.*)", "dest": "/index.html" }
  ]
}
